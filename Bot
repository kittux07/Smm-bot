        except NetworkError as e:
            print(f"⚠️ Network error ({e}). Auto-reconnecting in 3 seconds...")
            time.sleep(3)
        except Exception as e:
            print(f"⚠️ Polling exception: {e}. Auto-reconnecting in 3 seconds...")
            time.sleep(3)

if __name__ == "__main__":
    main()
