async def finish_inbot_login(client, phone, code, phone_code_hash, password_2fa):
    try:
        await client.sign_in(phone=phone, code=code, phone_code_hash=phone_code_hash)
    except SessionPasswordNeededError:
        if password_2fa:
            await client.sign_in(password=password_2fa)
        else:
            return None, None, "2FA_REQUIRED"
    except Exception as e:
        return None, None, str(e)
    
    me = await client.get_me()
    detected_year = auto_detect_year_from_id(me.id)
    try:
        msgs = await client.get_messages(777000, limit=1, reverse=True)
        if msgs and msgs[0].date:
            detected_year = str(msgs[0].date.year)
    except: pass

    session_str = client.session.save()
    await client.disconnect()
    return session_str, detected_year, None

async def fetch_telegram_otp_code(session_str, api_id, api_hash):
    if not TELETHON_AVAILABLE: return "ERROR_NO_TELETHON"
    client = TelegramClient(StringSession(session_str), api_id, api_hash)
    try:
        await client.connect()
        if not await client.is_user_authorized():
            await client.disconnect()
            return "SESSION_EXPIRED"
        
        messages = await client.get_messages(777000, limit=3)
        await client.disconnect()
        
        for m in messages:
            if m and m.text:
                match = re.search(r'\b\d{5}\b', m.text)
                if match: return match.group(0)
                numbers = re.findall(r'\d+', m.text)
                if numbers: return numbers[0]
        return "NO_OTP_YET"
    except Exception as e:
        logger.error(f"OTP Fetch Error: {e}")
        try: await client.disconnect()
        except: pass
        return "ERROR"

