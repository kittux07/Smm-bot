    async def get_available_tg_categories(self, provider="local"):
        pipeline = [
            {"$match": {"status": "available", "provider": provider}},
            {"$group": {"_id": "$category", "stock": {"$sum": 1}, "price": {"$first": "$price"}}}
        ]
        return [doc async for doc in self.tg_accounts.aggregate(pipeline)]

    async def get_available_years_stock(self):
        pipeline = [
            {"$match": {"status": "available", "provider": "local"}},
            {"$group": {"_id": "$year", "stock": {"$sum": 1}, "price": {"$first": "$price"}}}
        ]
        return [doc async for doc in self.tg_accounts.aggregate(pipeline)]

