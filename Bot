def force_check_fampay_utr(utr, conf):
    if sync_db.verification_logs.find_one({"utr": utr}): return False
    email_id, password = conf.get("imap_email"), conf.get("imap_password")
    if not email_id or not password: return False
    try:
        client = imaplib.IMAP4_SSL(IMAP_HOST, IMAP_PORT)
        client.login(email_id, password)
        client.select("INBOX")
        cutoff = (utcnow() - timedelta(days=1)).strftime("%d-%b-%Y")
        _, data = client.search(None, "FROM", IMAP_SENDER, "SINCE", cutoff)
        msg_ids = data[0].split() if data and data[0] else []
        found = False
        for mid in reversed(msg_ids[-15:]):
            email_uid = mid.decode()
            if sync_db.verification_logs.find_one({"gmail_message_id": email_uid}): continue
            _, fetched = client.fetch(mid, "(RFC822)")
            for part in fetched:
                if isinstance(part, tuple):
                    msg = email.message_from_bytes(part[1], policy=policy.default)
                    body = msg.get_content() if not msg.is_multipart() else " ".join(str(p.get_content()) for p in msg.walk() if p.get_content_type().startswith("text/"))
                    combined = f"{msg.get('Subject', '')} {body}"
                    if utr in combined:
                        sync_db.verification_logs.insert_one({"utr": utr, "gmail_message_id": email_uid})
                        found = True
                        break
            if found: break
        client.logout()
        return found
    except Exception: return False

