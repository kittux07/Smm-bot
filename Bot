def imap_checker_loop():
    purpose_re = re.compile(rf"{re.escape(PURPOSE_PREFIX)}[A-Z0-9]{{14}}")
    while True:
        try:
            conf = sync_db.global_config.find_one({"_id": "main_config"}) or {}
            email_id, password = conf.get("imap_email"), conf.get("imap_password")
            if not email_id or not password:
                time.sleep(10)
                continue
            client = imaplib.IMAP4_SSL(IMAP_HOST, IMAP_PORT)
            client.login(email_id, password)
            client.select("INBOX")
            cutoff = (utcnow() - timedelta(days=1)).strftime("%d-%b-%Y")
            _, data = client.search(None, "FROM", IMAP_SENDER, "SINCE", cutoff)
            msg_ids = data[0].split() if data and data[0] else []
            for mid in reversed(msg_ids):
                if sync_db.verification_logs.find_one({"gmail_message_id": mid.decode()}): continue
                _, fetched = client.fetch(mid, "(RFC822)")
                for part in fetched:
                    if isinstance(part, tuple):
                        msg = email.message_from_bytes(part[1], policy=policy.default)
                        body = msg.get_content() if not msg.is_multipart() else " ".join(str(p.get_content()) for p in msg.walk() if p.get_content_type().startswith("text/"))
                        combined = f"{msg.get('Subject', '')} {body}"
                        p_match = purpose_re.search(combined)
                        if p_match:
                            purpose = p_match.group(0)
                            dep = sync_db.deposits.find_one({"purpose": purpose, "status": "pending"})
                            if dep:
                                amt = float(dep["amount"])
                                sync_db.deposits.update_one({"_id": dep["_id"]}, {"$set": {"status": "approved"}})
                                sync_db.users.update_one({"_id": dep["user_id"]}, {"$inc": {"balance": amt, "total_deposited": amt}}, upsert=True)
                                sync_db.verification_logs.insert_one({"gmail_message_id": mid.decode(), "purpose": purpose})
                                requests.get(f"https://api.telegram.org/bot{BOT_TOKEN}/sendMessage", params={"chat_id": dep["user_id"], "text": f"⚡ <b>Deposit Verified!</b>\n\n💰 Added to balance: <b>Rs {amt}</b>", "parse_mode": "HTML"}, timeout=10)
                                process_sync_referral_rewards(dep["user_id"], amt)
            client.logout()
        except Exception: pass
        time.sleep(5)
threading.Thread(target=imap_checker_loop, daemon=True).start()

def generate_branded_qr(upi_uri, amount, purpose, brand_name):
    qr = qrcode.QRCode(version=None, error_correction=ERROR_CORRECT_H, box_size=14, border=4)
    qr.add_data(upi_uri)
    qr.make(fit=True)
    qr_img = qr.make_image(fill_color="black", back_color="white").convert("RGB")
    canvas = Image.new("RGB", (1400, 1500), "#F6F8FC")
    draw = ImageDraw.Draw(canvas)
    draw.rounded_rectangle((90, 60, 1310, 1440), radius=54, fill="white", outline="#E3EAF6", width=3)
    draw.rounded_rectangle((90, 60, 1310, 220), radius=54, fill="#0F4C81")
    draw.rectangle((90, 150, 1310, 220), fill="#0F4C81")
    try: font_large = ImageFont.truetype("/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf", 40)
    except: font_large = ImageFont.load_default()
    draw.text((120, 95), str(brand_name), fill="white", font=font_large)
    qr_img = qr_img.resize((720, 720), Image.Resampling.LANCZOS)
    canvas.paste(qr_img, (340, 290))
    draw.text((580, 1050), f"Pay: Rs {format_amount(amount)}", fill="#0F4C81", font=font_large)
    draw.text((450, 1120), f"Purpose Code: {purpose}", fill="#102A43", font=font_large)
    out = BytesIO()
    canvas.save(out, format="PNG", optimize=True)
    return out.getvalue()

