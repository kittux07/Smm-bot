def auto_detect_country(phone):
    clean_p = re.sub(r'[^0-9]', '', str(phone))
    for length in [4, 3, 2, 1]:
        prefix = clean_p[:length]
        if prefix in COUNTRY_MAP:
            flag, name = COUNTRY_MAP[prefix]
            return f"{flag} {name}"
    return "🌐 International"

