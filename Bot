def calculate_rate(base_usd, global_inr, global_margin):
    try: u_rate = float(global_inr) if (global_inr is not None and str(global_inr).strip() not in ["", "None"]) else 92.0
    except: u_rate = 92.0
    try: m_rate = float(global_margin) if (global_margin is not None and str(global_margin).strip() not in ["", "None"]) else 2.0
    except: m_rate = 2.0
    try: b_usd = float(base_usd) if (base_usd is not None and str(base_usd).strip() not in ["", "None"]) else 0.0
    except: b_usd = 0.0
    return b_usd * u_rate * m_rate

