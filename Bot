class SMMDatabase:
    def __init__(self, uri):
        self._client = AsyncIOMotorClient(uri, maxPoolSize=2, minPoolSize=0, maxIdleTimeMS=10000, serverSelectionTimeoutMS=3000, connect=False)
        self.db = self._client["TrustedSMM_Bot"]
        self.users = self.db.users
        self.config = self.db.global_config
        self.deposits = self.db.deposits
        self.services = self.db.manual_services
        self.orders = self.db.orders
        self.gift_codes = self.db.gift_codes
        self.withdrawals = self.db.withdrawals
        self.tg_accounts = self.db.tg_accounts
        self.panels = self.db.smm_panels

    async def get_user(self, user_id):
        user = await self.users.find_one({"_id": user_id})
        if not user:
            user = {
                "_id": user_id, "balance": 0.0, "referral_balance": 0.0,
                "total_spend": 0.0, "total_deposited": 0.0,
                "referred_by": None, "referral_paid": False,
                "discount": 0.0, "last_daily_ts": 0, "banned": False
            }
            await self.users.insert_one(user)
        return user

    async def update_user(self, user_id, data): await self.users.update_one({"_id": user_id}, {"$set": data}, upsert=True)
    async def update_balance(self, user_id, amount): await self.users.update_one({"_id": user_id}, {"$inc": {"balance": amount}}, upsert=True)
    async def update_referral_balance(self, user_id, amount): await self.users.update_one({"_id": user_id}, {"$inc": {"referral_balance": amount}}, upsert=True)
    async def update_spend(self, user_id, amount): await self.users.update_one({"_id": user_id}, {"$inc": {"total_spend": amount}}, upsert=True)
    async def set_discount(self, user_id, percent): await self.users.update_one({"_id": user_id}, {"$set": {"discount": percent}}, upsert=True)

    async def count_referrals(self, user_id):
        pending = await self.users.count_documents({"referred_by": user_id, "referral_paid": False})
        confirmed = await self.users.count_documents({"referred_by": user_id, "referral_paid": True})
        return pending, confirmed

    async def create_gift_code(self, code, percent, owner_id=None):
        await self.gift_codes.insert_one({"_id": code.strip(), "percent": float(percent), "used": False, "owner_id": owner_id, "created_at": datetime.now()})

    async def get_and_use_gift_code(self, code, user_id):
        code_doc = await self.gift_codes.find_one({"_id": code.strip(), "used": False})
        if not code_doc: return None
        if code_doc.get("owner_id") and code_doc["owner_id"] != user_id: return "NOT_OWNER"
        await self.gift_codes.update_one({"_id": code.strip()}, {"$set": {"used": True, "claimed_by": user_id, "claimed_at": datetime.now()}})
        return code_doc

    async def get_user_unclaimed_codes(self, user_id):
        return [doc async for doc in self.gift_codes.find({"owner_id": user_id, "used": False})]

    async def create_withdrawal(self, wdr_id, user_id, amount, upi_id):
        await self.withdrawals.insert_one({"_id": str(wdr_id), "user_id": user_id, "amount": float(amount), "upi_id": upi_id, "status": "pending", "created_at": datetime.now()})

    async def get_withdrawal(self, wdr_id): return await self.withdrawals.find_one({"_id": str(wdr_id)})
    async def update_withdrawal_status(self, wdr_id, status): await self.withdrawals.update_one({"_id": str(wdr_id)}, {"$set": {"status": status}})

