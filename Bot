async def safe_edit_message(q, text, reply_markup=None, parse_mode="HTML"):
    try:
        if q.message and q.message.photo:
            if len(text) > 1020:
                short_text = text[:1015] + "..."
                return await q.edit_message_caption(caption=short_text, reply_markup=reply_markup, parse_mode=parse_mode)
            return await q.edit_message_caption(caption=text, reply_markup=reply_markup, parse_mode=parse_mode)
        else:
            return await q.edit_message_text(text=text, reply_markup=reply_markup, parse_mode=parse_mode)
    except BadRequest as e:
        if "Message is not modified" in str(e):
            return
        try:
            await q.message.delete()
            return await q.message.reply_text(text, reply_markup=reply_markup, parse_mode=parse_mode)
        except Exception: pass
    except Exception as e:
        logger.error(f"safe_edit_message error: {e}")

